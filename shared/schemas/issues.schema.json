{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataready.local/schemas/issues.schema.json",
  "title": "IssuesArtifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_id": { "type": "string" },
          "column_name": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "category": { "type": "string" },
          "problem_description": { "type": "string" },
          "business_impact": { "type": "string" }
        },
        "required": [
          "issue_id",
          "column_name",
          "severity",
          "category",
          "problem_description",
          "business_impact"
        ]
      }
    }
  },
  "required": ["issues"]
}

